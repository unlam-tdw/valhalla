# Read by `docker compose` only. The application does not load this file: when you run
# `mvn jetty:run` on the host, it reads DB_* from the process environment, not from here.
#
# That difference matters for DB_HOST. Compose resolves it as a service name on the docker
# network (`postgres`), which a host-side JVM cannot resolve; the host needs `localhost`.
# Do not `export $(cat .env)` before running Jetty -- set the host-side values explicitly.

POSTGRES_DB=valhalla
POSTGRES_USER=user
POSTGRES_PASSWORD=user

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valhalla
DB_USER=user
DB_PASSWORD=user

# Spring Security
SECURITY_SECRET=mySecretKeyForCSRFAtLeast32CharactersLong!

# Server
SERVER_PORT=8080
